POSTGRES_DB=northlife
POSTGRES_USER=northlife
POSTGRES_PASSWORD=
ConnectionStrings__Database=
Authentication__JwtKey=
ASPNETCORE_ENVIRONMENT=Development

# Required only when running --bootstrap-admin
BootstrapAdmin__Email=
BootstrapAdmin__Password=
BootstrapAdmin__FullName=
BootstrapAdmin__Phone=
BootstrapAdmin__BusinessName=
ImageStorage__RootPath=
GoogleMaps__ApiKey=
GoogleMaps__MapId=

# Keys that encrypt TOTP secrets; keep them on persistent storage.
DataProtection__KeysPath=

# Google sign-in (OAuth 2.0 Web client ID). Empty hides the Google button.
Google__ClientId=

# Email: Log (nothing sent), Smtp (Mailpit locally: host localhost, port 1025) or Brevo.
Email__Provider=Log
Email__From=no-reply@northlife.local
Email__FromName=NorthLife
Email__PublicBaseUrl=http://localhost:4200
Email__Smtp__Host=localhost
Email__Smtp__Port=1025
Email__BrevoApiKey=

# Analytics (phase 13). Defaults suit production; shorten them locally to see numbers sooner.
# Analytics__RollupIntervalSeconds=60
# Analytics__IngestLagSeconds=120
# Analytics__RawRetentionDays=90
# RateLimiting__AnalyticsPermitsPerMinute=120
# Prometheus /metrics: a bearer token, or (local Docker only) unauthenticated from private networks.
# Metrics__Token=
Metrics__AllowPrivateNetwork=true
# Password for the demo owners created by --seed-demo (owner1..owner6@demo.northlife.local).
Demo__OwnerPassword=
# Grafana admin password for `docker compose --profile monitoring up -d`.
GRAFANA_ADMIN_PASSWORD=
